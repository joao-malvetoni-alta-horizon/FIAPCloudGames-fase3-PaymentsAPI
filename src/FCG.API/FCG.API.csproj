<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <!-- Agente APM do New Relic: publica o profiler CLR e o agente em ./newrelic no
             output do publish. A instrumentação é ativada pelas variáveis CORECLR_* do
             Dockerfile; sem NEW_RELIC_LICENSE_KEY o agente simplesmente não conecta. -->
        <PackageReference Include="NewRelic.Agent" Version="10.54.0"/>
        <PackageReference Include="Serilog.AspNetCore" Version="9.*"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FCG.Application\FCG.Application.csproj"/>
        <ProjectReference Include="..\FCG.Infrastructure\FCG.Infrastructure.csproj"/>
    </ItemGroup>

</Project>
